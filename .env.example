# ============ 必填 ============

# PostgreSQL 連線字串（可用 Supabase 的資料庫；本系統只使用 "webinar" schema）
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# express-session 加密金鑰（隨機長字串；正式環境未設定會拒絕啟動）
SESSION_SECRET=

# 對外網址（寄信裡的直播間連結會用到）
APP_URL=https://your-domain.com

# ============ 寄信（Resend）============

# https://resend.com 的 API 金鑰；未設定時報名確認信／提醒信會寄送失敗（其餘功能正常）
RESEND_API_KEY=
# 寄件人，網域需先在 Resend 完成驗證
EMAIL_FROM="ICTA-WEBINAR <noreply@your-domain.com>"

# ============ AI 功能（選填）============

# Anthropic API 金鑰（https://console.anthropic.com）；未設定時 AI 助教／一鍵生成自動停用
ANTHROPIC_API_KEY=
# 選填：預設 claude-sonnet-5
# AI_MODEL=claude-sonnet-5

# ============ Stripe 訂閱（選填，自用單一帳號不需要）============

# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_MONTHLY_PRICE_ID=

# ============ 其他 ============

# PORT=5000
# 資料表所在的 PostgreSQL schema（預設 webinar，一般不需要改）
# DB_SCHEMA=webinar
